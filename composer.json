{
  "name": "edenchazard/uc-archive",
  "type": "project",
  "description": "Unicreatures archive.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "diglactic/laravel-breadcrumbs": "^10.1.0",
    "fakerphp/faker": "^1.24.1",
    "laravel/framework": "^13.21",
    "laravel/tinker": "^3.0",
    "phpstan/phpstan-mockery": "^2.0.0"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7.0",
    "itsgoingd/clockwork": "^5.3.5",
    "larastan/larastan": "^3.9.6",
    "laravel/pint": "^1.30",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4",
    "php-parallel-lint/php-parallel-lint": "^1.4.0",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1.54",
    "phpunit/phpunit": "^12.5.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "Illuminate\\Foundation\\ComposerScripts::postUpdate"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "lint": [
      "vendor/bin/parallel-lint --exclude resources --exclude vendor ."
    ],
    "pint": [
      "vendor/bin/pint --test"
    ],
    "analyse": [
      "phpstan analyse --memory-limit 2G"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "@lint",
      "@phpunit",
      "@analyse"
    ],
    "phpunit": [
      "php artisan test --coverage --min=1"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "barryvdh/laravel-ide-helper"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
